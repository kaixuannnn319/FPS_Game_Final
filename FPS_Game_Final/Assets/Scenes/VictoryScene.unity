  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f5f6ee0b48aef7a46b4bdf7aff931fe3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EndingCutsceneController
  cutsceneRoot: {fileID: 807959849}
  cutsceneImage: {fileID: 2038986401}
  subtitleText: {fileID: 4845017}
  canvasGroup: {fileID: 428413334}
  slides:
  - image: {fileID: 21300000, guid: 0de6b917d1549a6449d57b706f07b2ef, type: 3}
    subtitle: 'The fallen king is finally defeated.



      With the Demon Lord
      destroyed, the dark power that sustained his immortality begins to collapse.'
    duration: 5
  - image: {fileID: 21300000, guid: 21d1d203fdd88554dbda30ea32f4f107, type: 3}
    subtitle: 'The Sacred Crown, the Heart of Life, and the Seal of Protection shine
      upon the ancient altar.



      Their sacred power returns to the Guardian
      Spirit, and the curse placed upon Sanctoria begins to fade.'
    duration: 6
  - image: {fileID: 21300000, guid: ba147b1de86e7894aa8489ecb6a7d89d, type: 3}
    subtitle: 'The magical barrier surrounding the island shatters at last.



      Across
      the castle, the harbor, and the abandoned settlements, the corruption that
      haunted the land slowly disappears.'
    duration: 6
  - image: {fileID: 21300000, guid: 1646a3590282688479797124cb21a0a0, type: 3}
    subtitle: 'With the path to freedom finally opened, you return to the harbor
      and leave Sanctoria behind.



      As your boat crosses the quiet sea, the
      first light of dawn rises over the island.'
    duration: 6
  - image: {fileID: 21300000, guid: f785682919513524da8e2fc68a982f9e, type: 3}
    subtitle: 'After generations of darkness, Sanctoria is free once more.



      The
      Forgotten Island is forgotten no longer.'
    duration: 5
  fadeDuration: 0.6
  victoryPanel: {fileID: 1703852511}
  playOnStart: 1
