--- !u!114 &8949146804020755227
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6414210601524925910}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9c0eb9ddd513cb245900a8cd2ef296f4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - 'Traveler... do not mistake its slow steps for weakness. '
  - 'A towering Cyclop guards the path ahead, with strength enough to crush anything
    before it. '
  - 'Every strike can shatter the ground beneath your feet. Keep moving, and never
    stand in its path. '
  - 'Watch its movements carefully. Its body may be slow, but one direct blow could
    be your last. '
  animator: {fileID: 9095521772295793768}
